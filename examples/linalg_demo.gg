# Linear algebra: solving the systems from the maths ripasso.
#
# 2x + y = 5
#  x + 3y = 10
# has the solution x = 1, y = 3 — the same elimination
# (with partial pivoting) that `linalg.solve` does.
import linalg

let a = reshape(array([2, 1, 1, 3]), [2, 2])
let b = array([5, 10])
print "Soluzione di 2x + y = 5, x + 3y = 10:"
print linalg.solve(a, b)
print "Verifica (A per la soluzione deve dare b):"
print matmul(a, linalg.solve(a, b))
print "Determinante di A:"
print linalg.det(a)
print "Inversa di [[1, 2], [0, 1]]:"
print linalg.inv(reshape(array([1, 2, 0, 1]), [2, 2]))

# The classic 3x3 from the textbooks:
# 2x + y - z = 8, -3x - y + 2z = -11, -2x + y + 2z = -3
# (x = 2, y = 3, z = -1). In f64 the y comes out as
# 3.0000000000000004: elimination divides by 3, which has no
# exact binary form, so a little rounding is normal — the
# same happens in NumPy.
let c = reshape(array([2, 1, -1, -3, -1, 2, -2, 1, 2]), [3, 3])
print "Sistema 3x3 classico (x = 2, y = 3, z = -1):"
print linalg.solve(c, array([8, -11, -3]))
