# SPDX-License-Identifier: GPL-3.0-or-later
# Benchmark: a heavy numeric loop (sum of 1..N) and a recursive
# function (fib), to compare the tree-walking interpreter with
# the bytecode VM. Run with:
#
#   GG_BACKEND=tree time gg run examples/bench_loop.gg
#   GG_BACKEND=vm   time gg run examples/bench_loop.gg
#
# (Use a release build for meaningful numbers: `cargo build --release`.)

let n = 1000000
let s = 0
for i = 1 to n then
    s = s + i
end
print s
