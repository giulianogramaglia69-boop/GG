# Generators (Phase 23): a function whose body contains `yield`
# is a generator — calling it returns a `<generator>` without
# running the body; `next(gen)` replays it up to the next `yield`.
# When the body ends, `next()` fails with "generator exhausted"
# (catchable with `try`/`except`); `for x in gen` pulls lazily
# until then.

fn conta(n)
    let i = 1
    while i <= n then
        yield i * 10
        i = i + 1
    end
end

let g = conta(3)
print type(g)
print g
print next(g)
print next(g)
for x in g then
    print f"for: {x}"
end

# An infinite generator: `next()` only ever runs up to the
# N-th `yield`, so it never loops forever.
fn inf()
    let i = 0
    while true then
        yield i
        i = i + 1
    end
end

let h = inf()
print next(h)
print next(h)
print next(h)

# Exhaustion, caught with try/except.
try then
    print next(h)
    print next(g)
except e then
    print f"finito: {e}"
end

# Two generators from one function are independent.
let a = conta(2)
let b = conta(2)
print next(a)
print next(b)
print next(a)
print next(b)
